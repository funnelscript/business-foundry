# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment Variables, Secrets & Keys (Gate 0 Hard Enforcement)
.env
.env.*
*.env
*.local
!*.example
!*.template
*.pem
*.key
*.cert
*.crt
id_rsa*
secrets/
credentials/
agent-kernel/env-vault/

# Python Caches, Virtual Environments & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
build/
dist/
wheels/
*.egg-info/
*.egg
.venv/
venv/
env/
ENV/

# Node, TypeScript & Bun Artifacts
node_modules/
.bun/
*.tsbuildinfo
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs, Code Editors & Tooling
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Agent Frameworks, Local Workspaces, Worktrees & Transient Caches
/.agents/
/.agents
/plans/
/plans
.poteto/
.pstack/
.anti-slop/
.claude-plugin/
.codex-plugin/
.gemini/
